<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>

<VBox spacing="16.0" styleClass="page-container" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="SimulationController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <!-- Playback & Time Step Controls -->
    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="card-panel">
        <padding>
            <Insets bottom="12.0" left="18.0" right="18.0" top="12.0" />
        </padding>
        <Label styleClass="section-title" text="Simulation Timeline" />
        <Label fx:id="currentTimeLabel" styleClass="kpi-badge" text="Current Time: T = 0" />
        <Label fx:id="runningCpuLabel" styleClass="cpu-badge" text="CPU State: IDLE" />
        <Region HBox.hgrow="ALWAYS" />
        <Label text="Speed:" />
        <Slider fx:id="speedSlider" max="100" min="10" prefWidth="110.0" value="50" />
        <Button fx:id="prevStepBtn" onAction="#handlePrevStep" styleClass="secondary-btn" text="◀ Prev Step" />
        <Button fx:id="playPauseBtn" onAction="#handlePlayPause" styleClass="primary-btn" text="⏯ Play / Pause" />
        <Button fx:id="nextStepBtn" onAction="#handleNextStep" styleClass="secondary-btn" text="Next Step ▶" />
        <Button fx:id="resetSimBtn" onAction="#handleReset" styleClass="danger-btn" text="Reset" />
    </HBox>

    <!-- Gantt Chart Container -->
    <VBox spacing="10.0" styleClass="card-panel">
        <padding>
            <Insets bottom="15.0" left="18.0" right="18.0" top="15.0" />
        </padding>
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <Label styleClass="section-title" text="CPU Gantt Chart Timeline" />
            <Region HBox.hgrow="ALWAYS" />
            <Label styleClass="legend-cs" text="■ Context Switch (CS)" />
            <Label styleClass="legend-idle" text="■ CPU Idle" />
        </HBox>
        <ScrollPane fitToHeight="true" prefHeight="105.0" styleClass="gantt-scroll">
            <content>
                <HBox fx:id="ganttChartContainer" alignment="CENTER_LEFT" spacing="2.0">
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                </HBox>
            </content>
        </ScrollPane>
    </VBox>

    <!-- Middle Section: Multi-Tier Queues & Heuristic Demotion Matrix Log -->
    <HBox spacing="16.0" VBox.vgrow="ALWAYS">
        <!-- Queues Visualizer -->
        <VBox spacing="14.0" styleClass="card-panel" HBox.hgrow="ALWAYS">
            <padding>
                <Insets bottom="16.0" left="18.0" right="18.0" top="16.0" />
            </padding>
            <Label styleClass="section-title" text="Multi-Tier Queues State" />
            <Separator />

            <Label styleClass="tier1-title" text="Tier 1: Round Robin Queue (Interactive Tasks)" />
            <ScrollPane fitToHeight="true" prefHeight="110.0" styleClass="queue-scroll">
                <content>
                    <HBox fx:id="tier1QueueBox" alignment="CENTER_LEFT" spacing="10.0">
                        <padding>
                            <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                        </padding>
                    </HBox>
                </content>
            </ScrollPane>

            <Label styleClass="tier2-title" text="Tier 2: Non-Preemptive Priority Queue with Aging (Batch Jobs)" />
            <ScrollPane fitToHeight="true" prefHeight="110.0" styleClass="queue-scroll">
                <content>
                    <HBox fx:id="tier2QueueBox" alignment="CENTER_LEFT" spacing="10.0">
                        <padding>
                            <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                        </padding>
                    </HBox>
                </content>
            </ScrollPane>
        </VBox>

        <!-- Step-by-Step Execution & Demotion Matrix Table -->
        <VBox prefWidth="760.0" spacing="10.0" styleClass="card-panel" HBox.hgrow="ALWAYS">
            <padding>
                <Insets bottom="16.0" left="18.0" right="18.0" top="16.0" />
            </padding>
            <Label styleClass="section-title" text="Heuristic Demotion &amp; Execution Matrix" />
            <Separator />
            <TableView fx:id="executionTableView" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="logTimeCol" maxWidth="80.0" minWidth="70.0" prefWidth="75.0" text="Time" />
                    <TableColumn fx:id="logCpuCol" maxWidth="130.0" minWidth="100.0" prefWidth="115.0" text="CPU" />
                    <TableColumn fx:id="logTier1Col" prefWidth="280.0" text="Tier 1 Queue" />
                    <TableColumn fx:id="logTier2Col" prefWidth="280.0" text="Tier 2 Queue" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </HBox>
</VBox>
